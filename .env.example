# Proxy configuration (optional)
# Applies to Reddit requests only. Hacker News and GitHub always go direct.
# Supports: http://, https://, socks5://, socks5h://
# socks5h:// resolves DNS on the proxy side

# REDDIT_PROXY=http://127.0.0.1:8080
# REDDIT_PROXY=socks5://127.0.0.1:1080
# REDDIT_PROXY=socks5h://user:pass@proxy.example.com:1080

# Server port (default: 3000)
# PORT=3000

# Logging verbosity
# RUST_LOG=tty1=debug,info

# Directory for the persisted snapshot and Reddit session (default: state)
# STATE_DIR=/var/lib/tty1

# Skip the Reddit worker during manual UI testing (avoids rate limits)
# DISABLE_REDDIT=1

# Skip all background workers (HN/GitHub/Reddit) for deterministic UI testing
# DISABLE_SCRAPERS=1
