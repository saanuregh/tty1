// Must stay .jsonc: Biome reads biome.json as strict JSON, so a comment there
// is a configuration error.
{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!.claude",
			"!src/static/*.bundle.js",
			"!src/static/*.bundle.css"
		]
	},
	"formatter": {
		"indentStyle": "tab"
	},
	"linter": {
		"rules": {
			"preset": "recommended",
			"a11y": {
				"noSvgWithoutTitle": "off"
			},
			"correctness": {
				// Generated bundles are ignored above; source files are ES modules.
				"noUnusedFunctionParameters": "off"
			},
			"suspicious": {
				// forEach with single-expression arrows harmlessly return values
				"useIterableCallbackReturn": "off"
			}
		}
	},
	"css": {
		// !important in prefers-reduced-motion overrides is intentional
		"linter": {
			"enabled": false
		}
	}
}
