// Must stay .jsonc: biome.json rejects comments and silently falls back to
// defaults, which drops the .gitignore exclusion and lints all of target/.
{
	"$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["**", "!.claude"]
	},
	"formatter": {
		"indentStyle": "tab"
	},
	"linter": {
		"rules": {
			"preset": "recommended",
			"a11y": {
				"noSvgWithoutTitle": "off"
			},
			"correctness": {
				// JS files share global scope via include_str!() — not modules
				"noUnusedVariables": "off",
				"noUnusedFunctionParameters": "off"
			},
			"suspicious": {
				// forEach with single-expression arrows harmlessly return values
				"useIterableCallbackReturn": "off"
			}
		}
	},
	"css": {
		// !important in prefers-reduced-motion overrides is intentional
		"linter": {
			"enabled": false
		}
	}
}
